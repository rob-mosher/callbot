# ---- LLM (local, on your subnet) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ---- STT (cloud) ----
DEEPGRAM_API_KEY=

# ---- Telephony (Daily PSTN) ----
# Requires dial-out enabled on your Daily domain + a purchased Daily number.
DAILY_API_KEY=
DAILY_CALLER_ID=          # your purchased Daily number, E.164 e.g. +15551234567
PRINCIPAL_NUMBER=         # YOUR phone; the number the bot bridges in, E.164

# ---- Behavior ----
BOT_NAME=Ash
# Don't declare a human in the first N seconds of a call (false-positive guard).
MIN_SECONDS_BEFORE_BRIDGE=15
# Give up if nobody useful is reached.
MAX_CALL_SECONDS=900
# Ring time to wait for you to pick up the bridge call.
PRINCIPAL_ANSWER_TIMEOUT=45
# Persist transcripts to disk. Off by default: two-party-consent states.
RETAIN_TRANSCRIPTS=false
